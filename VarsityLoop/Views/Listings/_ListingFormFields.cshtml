@model VarsityLoop.Models.ViewModels.Listings.ListingFormViewModel
@{
    var categories = ViewBag.Categories as List<VarsityLoop.Models.Entities.Category> ?? new();
}

<input type="hidden" asp-for="Id" />

<div class="mb-3">
    <label asp-for="CategoryId" class="form-label"></label>
    <select asp-for="CategoryId" id="categorySelect" class="form-select">
        <option value="">Select a category...</option>
        @foreach (var category in categories)
        {
            <option value="@category.Id" data-module="@category.Module" selected="@(Model.CategoryId == category.Id)">@category.Name</option>
        }
    </select>
    <span asp-validation-for="CategoryId" class="invalid-feedback d-block small"></span>
</div>

@if (Model.ExistingImageUrls.Any())
{
    <div class="mb-3">
        <label class="form-label">Current Photos</label>
        <div class="d-flex gap-2 flex-wrap">
            @for (var i = 0; i < Model.ExistingImageUrls.Count; i++)
            {
                <img src="@Model.ExistingImageUrls[i]" style="width: 90px; height: 90px; object-fit: cover; border-radius: 0.5rem;" />
                <input type="hidden" name="ExistingImageUrls[@i]" value="@Model.ExistingImageUrls[i]" />
            }
        </div>
        <p class="text-muted small mt-1 mb-0">Uploading new photos below adds to these (up to 6 total). Photo removal is coming soon.</p>
    </div>
}

<div class="mb-3">
    <label asp-for="ImageFiles" class="form-label"></label>
    <input type="file" name="ImageFiles" multiple class="form-control" accept="image/png,image/jpeg,image/webp" />
    <span asp-validation-for="ImageFiles" class="invalid-feedback d-block small"></span>
    <p class="text-muted small mt-1 mb-0">JPG, PNG, or WEBP. Up to 6 photos, 5MB each.</p>
</div>

<div class="mb-3">
    <label asp-for="Title" class="form-label"></label>
    <input asp-for="Title" class="form-control" />
    <span asp-validation-for="Title" class="invalid-feedback d-block small"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Description" class="invalid-feedback d-block small"></span>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <label asp-for="Price" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">R</span>
            <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" />
        </div>
        <span asp-validation-for="Price" class="invalid-feedback d-block small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Condition" class="form-label"></label>
        <select asp-for="Condition" class="form-select" asp-items="Html.GetEnumSelectList<VarsityLoop.Models.Entities.ListingCondition>()"></select>
    </div>
</div>

@* ---------- Books fields ---------- *@
<div class="vl-module-fields" data-for-module="Books">
    <div class="vl-card p-3 mb-3 bg-light border-0">
        <h6 class="text-muted text-uppercase small mb-3" style="letter-spacing: 0.03em;">Book Details</h6>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Author" class="form-label"></label>
                <input asp-for="Author" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="Isbn" class="form-label"></label>
                <input asp-for="Isbn" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="Course" class="form-label"></label>
                <input asp-for="Course" class="form-control" placeholder="e.g. ECO101" />
            </div>
            <div class="col-md-4">
                <label asp-for="Faculty" class="form-label"></label>
                <input asp-for="Faculty" class="form-control" placeholder="e.g. Commerce" />
            </div>
        </div>
    </div>
</div>

@* ---------- Electronics / Fashion / Study Supplies fields ---------- *@
<div class="vl-module-fields" data-for-module="Electronics Fashion StudySupplies">
    <div class="vl-card p-3 mb-3 bg-light border-0">
        <h6 class="text-muted text-uppercase small mb-3" style="letter-spacing: 0.03em;">Item Details</h6>
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label asp-for="Type" class="form-label"></label>
                <input asp-for="Type" class="form-control" list="typeSuggestions" placeholder="e.g. Laptop" />
                <datalist id="typeSuggestions">
                    @foreach (var suggestion in VarsityLoop.Models.Common.ListingTypeSuggestions.Electronics)
                    {
                        <option value="@suggestion"></option>
                    }
                </datalist>
            </div>
            <div class="col-md-4">
                <label asp-for="Brand" class="form-label"></label>
                <input asp-for="Brand" class="form-control" placeholder="e.g. Samsung" />
            </div>
            <div class="col-md-4">
                <label asp-for="Model" class="form-label"></label>
                <input asp-for="Model" class="form-control" placeholder="e.g. Galaxy A06" />
            </div>
        </div>

        <label class="form-label">Specifications</label>
        <div id="specRows">
            @{ var specs = Model.Specifications is { Count: > 0 } ? Model.Specifications : new List<string> { "" }; }
            @foreach (var spec in specs)
            {
                <div class="input-group mb-2 vl-spec-row">
                    <input type="text" name="Specifications" class="form-control" value="@spec" placeholder="e.g. 8GB RAM" />
                    <button type="button" class="btn btn-outline-secondary vl-spec-remove">&times;</button>
                </div>
            }
        </div>
        <button type="button" id="addSpecBtn" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-plus-lg"></i> Add Specification
        </button>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <label asp-for="University" class="form-label"></label>
        <input asp-for="University" class="form-control" />
        <span asp-validation-for="University" class="invalid-feedback d-block small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" placeholder="e.g. Main Campus" />
    </div>
</div>
