@model VarsityLoop.Models.ViewModels.Listings.ListingFormViewModel
@{
    ViewData["Title"] = "Edit Listing";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="h3 mb-4">Edit Listing</h1>

            <form asp-controller="Listings" asp-action="Edit" method="post" enctype="multipart/form-data" novalidate>
                <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                <partial name="_ListingFormFields" model="Model" />
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-controller="Listings" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
