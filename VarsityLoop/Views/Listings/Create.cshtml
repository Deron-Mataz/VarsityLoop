@model VarsityLoop.Models.ViewModels.Listings.ListingFormViewModel
@{
    ViewData["Title"] = "List an Item";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="h3 mb-4">List an Item</h1>

            <form asp-controller="Listings" asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <partial name="_ListingFormFields" model="Model" />
                <button type="submit" class="btn btn-primary">Publish Listing</button>
            </form>
        </div>
    </div>
</div>
