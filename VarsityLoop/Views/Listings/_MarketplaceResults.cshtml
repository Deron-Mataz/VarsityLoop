@model VarsityLoop.Models.ViewModels.Listings.ListingBrowseResult

@if (Model.Items.Count == 0)
{
    <div class="vl-card vl-empty-state">
        <h5>No listings match</h5>
        <p class="mb-0">Try a different search, module, or category.</p>
    </div>
}
else
{
    <p class="text-muted small mb-3">@Model.TotalCount result@(Model.TotalCount == 1 ? "" : "s")</p>

    <div class="row g-4">
        @foreach (var listing in Model.Items)
        {
            <div class="col-sm-6 col-md-4 col-lg-3">
                <partial name="_ListingCard" model="listing" />
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" href="#" data-marketplace-page="@p">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
