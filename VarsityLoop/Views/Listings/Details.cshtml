@model VarsityLoop.Models.Entities.Listing
@{
    ViewData["Title"] = Model.Title;
    var isOwner = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == Model.SellerId;
}

<div class="container py-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @if (Model.Status != nameof(VarsityLoop.Models.Entities.ListingStatus.Active))
    {
        <div class="alert alert-warning">This listing is currently <strong>@Model.Status</strong> and only visible to you.</div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="vl-card overflow-hidden mb-3" style="aspect-ratio: 4/3; background: #eef0f3;">
                @if (Model.ImageUrls.Count > 0)
                {
                    <img src="@Model.ImageUrls[0]" alt="@Model.Title" class="w-100 h-100" style="object-fit: cover;" />
                }
                else
                {
                    <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted">No photo</div>
                }
            </div>
            @if (Model.ImageUrls.Count > 1)
            {
                <div class="d-flex gap-2 flex-wrap">
                    @foreach (var url in Model.ImageUrls.Skip(1))
                    {
                        <img src="@url" alt="@Model.Title" style="width: 80px; height: 80px; object-fit: cover; border-radius: 0.5rem;" />
                    }
                </div>
            }
        </div>

        <div class="col-lg-5">
            <h1 class="h3 mb-1">@Model.Title</h1>
            <p class="text-muted mb-3">@(!string.IsNullOrEmpty(Model.Author) ? Model.Author : $"{Model.Brand} {Model.Model}".Trim())</p>
            <p class="h4 text-primary mb-3">R@(Model.Price.ToString("N2"))</p>

            <div class="vl-card p-3 mb-3">
                <dl class="row mb-0 small">
                    <dt class="col-5">Category</dt><dd class="col-7">@Model.CategoryName</dd>
                    <dt class="col-5">Condition</dt><dd class="col-7">@Model.Condition</dd>
                    @if (!string.IsNullOrEmpty(Model.Author) || !string.IsNullOrEmpty(Model.Course) || !string.IsNullOrEmpty(Model.Isbn) || !string.IsNullOrEmpty(Model.Faculty))
                    {
                        @if (!string.IsNullOrEmpty(Model.Author))
                        {
                            <dt class="col-5">Author</dt><dd class="col-7">@Model.Author</dd>
                        }
                        @if (!string.IsNullOrEmpty(Model.Course))
                        {
                            <dt class="col-5">Course</dt><dd class="col-7">@Model.Course</dd>
                        }
                        @if (!string.IsNullOrEmpty(Model.Faculty))
                        {
                            <dt class="col-5">Faculty</dt><dd class="col-7">@Model.Faculty</dd>
                        }
                        @if (!string.IsNullOrEmpty(Model.Isbn))
                        {
                            <dt class="col-5">ISBN</dt><dd class="col-7">@Model.Isbn</dd>
                        }
                    }
                    @if (!string.IsNullOrEmpty(Model.Type))
                    {
                        <dt class="col-5">Type</dt><dd class="col-7">@Model.Type</dd>
                    }
                    @if (!string.IsNullOrEmpty(Model.Brand))
                    {
                        <dt class="col-5">Brand</dt><dd class="col-7">@Model.Brand</dd>
                    }
                    @if (!string.IsNullOrEmpty(Model.Model))
                    {
                        <dt class="col-5">Model</dt><dd class="col-7">@Model.Model</dd>
                    }
                    <dt class="col-5">University</dt><dd class="col-7">@Model.University</dd>
                    <dt class="col-5">Location</dt><dd class="col-7">@(Model.Location ?? "—")</dd>
                </dl>
            </div>

            @if (Model.Specifications is { Count: > 0 })
            {
                <div class="vl-card p-3 mb-3">
                    <h2 class="h6">Specifications</h2>
                    <ul class="mb-0 small">
                        @foreach (var spec in Model.Specifications)
                        {
                            <li>@spec</li>
                        }
                    </ul>
                </div>
            }

            <div class="vl-card p-3 mb-3">
                <h2 class="h6">Description</h2>
                <p class="mb-0" style="white-space: pre-wrap;">@Model.Description</p>
            </div>

            <div class="vl-card p-3 mb-3">
                <h2 class="h6 mb-1">Seller</h2>
                <a asp-controller="Sellers" asp-action="Details" asp-route-id="@Model.SellerId" class="mb-0 text-decoration-none">@Model.SellerName</a>
            </div>

            @if (!isOwner && User.Identity?.IsAuthenticated == true)
            {
                var isFavorited = ViewData["IsFavorited"] as bool? ?? false;
                <form asp-controller="Favorites" asp-action="Toggle" method="post" class="mb-3">
                    <input type="hidden" name="listingId" value="@Model.Id" />
                    <button type="submit" class="btn @(isFavorited ? "btn-primary" : "btn-outline-primary") w-100">
                        <i class="bi @(isFavorited ? "bi-star-fill" : "bi-star") me-1"></i>@(isFavorited ? "Saved to Favorites" : "Save to Favorites")
                    </button>
                </form>
            }

            @if (isOwner)
            {
                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="Listings" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit</a>
                    @if (Model.Status == nameof(VarsityLoop.Models.Entities.ListingStatus.Active))
                    {
                        <form asp-controller="Listings" asp-action="Pause" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="btn btn-outline-secondary">Pause</button>
                        </form>
                    }
                    else if (Model.Status == nameof(VarsityLoop.Models.Entities.ListingStatus.Paused))
                    {
                        <form asp-controller="Listings" asp-action="Reactivate" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="btn btn-outline-primary">Reactivate</button>
                        </form>
                    }
                    <form asp-controller="Listings" asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Delete this listing? This can\'t be undone.');">
                        <button type="submit" class="btn btn-outline-danger">Delete</button>
                    </form>
                </div>
            }
            else
            {
                <p class="text-muted small">Contact the seller feature is coming soon - for now, reach out via your university's usual channels.</p>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <details class="mt-3">
                        <summary class="text-muted small" style="cursor: pointer;">Report this listing</summary>
                        <form asp-controller="Listings" asp-action="Report" asp-route-id="@Model.Id" method="post" class="mt-2">
                            <textarea name="reason" class="form-control form-control-sm mb-2" rows="2" placeholder="Why are you reporting this listing?" required></textarea>
                            <button type="submit" class="btn btn-sm btn-outline-danger">Submit Report</button>
                        </form>
                    </details>
                }
            }
        </div>
    </div>
</div>
