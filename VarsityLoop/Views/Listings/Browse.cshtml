@model VarsityLoop.Models.ViewModels.Listings.ListingBrowseViewModel
@{
    ViewData["Title"] = "Marketplace";
    var q = Model.Query;
    var modules = new[] { "Books", "Electronics", "Fashion", "Accessories", "StudySupplies" };
    var moduleLabels = new Dictionary<string, string>
    {
        { "Books", "Books" }, { "Electronics", "Electronics" }, { "Fashion", "Fashion" },
        { "Accessories", "Accessories" }, { "StudySupplies", "Study Supplies" }
    };
    var currentModule = Model.HomeFeed != null
        ? ""
        : (!string.IsNullOrEmpty(q.Module)
            ? q.Module
            : Model.Categories.FirstOrDefault(c => c.Id == q.CategoryId)?.Module ?? "");
}

<div class="container py-5"
     id="marketplaceRoot"
     data-browse-url="@Url.Action("Browse", "Listings")"
     data-initial-module="@currentModule"
     data-initial-category="@q.CategoryId"
     data-initial-sort="@q.Sort">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <h1 class="h3 mb-0">Marketplace</h1>
        <a asp-controller="Listings" asp-action="Create" class="btn btn-primary">List an Item</a>
    </div>

    @* ---------- Search bar (above module nav - the primary action) ---------- *@
    <form id="marketplaceSearchForm" class="vl-card p-2 d-flex mb-3" style="max-width: 640px;">
        <input type="text" id="marketplaceSearchInput" value="@q.SearchTerm" class="form-control border-0" placeholder="Search the marketplace..." />
        <button type="submit" class="btn btn-primary ms-2"><i class="bi bi-search"></i></button>
    </form>

    @* ---------- Module navigation ---------- *@
    <div class="vl-module-nav mb-3">
        <button type="button" class="vl-module-btn @(string.IsNullOrEmpty(currentModule) ? "active" : "")" data-module="">All</button>
        @foreach (var m in modules)
        {
            <button type="button" class="vl-module-btn @(currentModule == m ? "active" : "")" data-module="@m">@moduleLabels[m]</button>
        }
    </div>

    @* ---------- Category chips (filtered to the selected module by JS) ---------- *@
    <div id="categoryChips" class="d-flex gap-2 flex-wrap mb-4" style="display: @(string.IsNullOrEmpty(currentModule) ? "none" : "flex");">
        @foreach (var category in Model.Categories)
        {
            <span class="vl-category-chip @(q.CategoryId == category.Id ? "active" : "")"
                  data-module="@category.Module" data-category-id="@category.Id"
                  style="display: @(category.Module == currentModule ? "inline-block" : "none");">
                @if (!string.IsNullOrEmpty(category.IconClass))
                {
                    <i class="bi @category.IconClass me-1"></i>
                }
                @category.Name
            </span>
        }
    </div>

    @* ---------- Results (server-rendered on first load, AJAX-swapped after) ---------- *@
    <div id="marketplaceResults">
        @if (Model.HomeFeed != null)
        {
            <partial name="_MarketplaceHomeFeed" model="Model.HomeFeed" />
        }
        else
        {
            <partial name="_MarketplaceResults" model="Model.Result" />
        }
    </div>
</div>
