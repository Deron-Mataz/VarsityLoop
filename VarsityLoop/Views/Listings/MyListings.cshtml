@model List<VarsityLoop.Models.Entities.Listing>
@{
    ViewData["Title"] = "My Listings";
}

<div class="container py-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">My Listings</h1>
        <a asp-controller="Listings" asp-action="Create" class="btn btn-primary">List an Item</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="vl-card vl-empty-state">
            <h5>You haven't listed anything yet</h5>
            <p class="mb-0">Create your first listing to start selling.</p>
        </div>
    }
    else
    {
        <div class="vl-card">
            <table class="table mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Listing</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th>Views</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var listing in Model)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Listings" asp-action="Details" asp-route-id="@listing.Id" class="text-reset text-decoration-none fw-semibold">
                                    @listing.Title
                                </a>
                            </td>
                            <td>R@(listing.Price.ToString("N2"))</td>
                            <td>
                                @if (listing.Status == nameof(VarsityLoop.Models.Entities.ListingStatus.Active))
                                {
                                    <span class="badge badge-green">Active</span>
                                }
                                else if (listing.Status == nameof(VarsityLoop.Models.Entities.ListingStatus.Paused))
                                {
                                    <span class="badge bg-secondary">Paused</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">@listing.Status</span>
                                }
                            </td>
                            <td>@listing.Views</td>
                            <td class="text-end">
                                <div class="d-flex gap-2 justify-content-end">
                                    <a asp-controller="Listings" asp-action="Edit" asp-route-id="@listing.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    @if (listing.Status == nameof(VarsityLoop.Models.Entities.ListingStatus.Active))
                                    {
                                        <form asp-controller="Listings" asp-action="Pause" asp-route-id="@listing.Id" method="post">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Pause</button>
                                        </form>
                                    }
                                    else if (listing.Status == nameof(VarsityLoop.Models.Entities.ListingStatus.Paused))
                                    {
                                        <form asp-controller="Listings" asp-action="Reactivate" asp-route-id="@listing.Id" method="post">
                                            <button type="submit" class="btn btn-sm btn-outline-primary">Reactivate</button>
                                        </form>
                                    }
                                    <form asp-controller="Listings" asp-action="Delete" asp-route-id="@listing.Id" method="post" onsubmit="return confirm('Delete this listing?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
