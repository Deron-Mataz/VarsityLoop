@{
    ViewData["Title"] = "Page Not Found";
    Layout = "_Layout";
}
<div class="container py-5 text-center">
    <h1 class="display-4 fw-bold text-primary">404</h1>
    <h2 class="h4 mb-3">We couldn't find that page</h2>
    <p class="text-muted mb-4">The page you're looking for may have been moved, removed, or never existed.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to Home</a>
</div>
