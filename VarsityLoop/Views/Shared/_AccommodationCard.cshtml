@model VarsityLoop.Models.Entities.Accommodation

<div class="vl-card vl-card-hover h-100 d-flex flex-column overflow-hidden">
    <a asp-controller="Accommodation" asp-action="Details" asp-route-id="@Model.Id" class="text-reset text-decoration-none">
        <div style="aspect-ratio: 4/3; background: #eef0f3; overflow: hidden;">
            @if (Model.Gallery.Count > 0)
            {
                <img src="@Model.Gallery[0]" alt="@Model.ResidenceName" class="w-100 h-100" style="object-fit: cover;" />
            }
            else
            {
                <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted small">No photo</div>
            }
        </div>
    </a>
    <div class="p-3 d-flex flex-column flex-grow-1">
        <span class="badge @(Model.Classification == "Accredited" ? "badge-green" : "bg-secondary") mb-2 align-self-start">@Model.Classification</span>
        <a asp-controller="Accommodation" asp-action="Details" asp-route-id="@Model.Id" class="text-reset text-decoration-none">
            <h3 class="h6 mb-1">@Model.ResidenceName</h3>
        </a>
        <p class="text-muted small mb-2">@Model.AccommodationType &middot; @Model.University</p>
        <div class="mt-auto d-flex justify-content-between align-items-center">
            <span class="fw-bold">R@(Model.MonthlyRent.ToString("N0"))/mo</span>
            <span class="text-muted small">@Model.DistanceFromCampus</span>
        </div>
    </div>
</div>
