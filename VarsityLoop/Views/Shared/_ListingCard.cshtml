@model VarsityLoop.Models.Entities.Listing

<div class="vl-card vl-card-hover h-100 d-flex flex-column overflow-hidden">
    <a asp-controller="Listings" asp-action="Details" asp-route-id="@Model.Id" class="text-reset text-decoration-none">
        <div style="aspect-ratio: 4/3; background: #eef0f3; overflow: hidden;">
            @if (Model.ImageUrls.Count > 0)
            {
                <img src="@Model.ImageUrls[0]" alt="@Model.Title" class="w-100 h-100" style="object-fit: cover;" />
            }
            else
            {
                <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted small">No photo</div>
            }
        </div>
    </a>
    <div class="p-3 d-flex flex-column flex-grow-1">
        @if (Model.Status == nameof(VarsityLoop.Models.Entities.ListingStatus.Paused))
        {
            <span class="badge bg-secondary mb-2 align-self-start">Paused</span>
        }
        <a asp-controller="Listings" asp-action="Details" asp-route-id="@Model.Id" class="text-reset text-decoration-none">
            <h3 class="h6 mb-1">@Model.Title</h3>
        </a>
        <p class="text-muted small mb-2">@Model.CategoryName @(string.IsNullOrEmpty(Model.CategoryName) ? "" : "·") @Model.Condition</p>
        <div class="mt-auto d-flex justify-content-between align-items-center">
            <span class="fw-bold">R@(Model.Price.ToString("N2"))</span>
            <span class="text-muted small">@Model.University</span>
        </div>
    </div>
</div>
