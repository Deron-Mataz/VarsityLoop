@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-5">
    <h1 class="h3 mb-2">Admin Dashboard</h1>
    <p class="text-muted mb-4">Signed in as <strong>@User.Identity?.Name</strong> (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</p>

    <div class="row g-3">
        <div class="col-md-4">
            <a asp-controller="AdminUsers" asp-action="Index" class="vl-card p-4 d-block text-decoration-none text-reset h-100">
                <h5 class="mb-1">Users</h5>
                <p class="text-muted small mb-0">Search users, assign roles, deactivate or delete accounts.</p>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-controller="AdminListings" asp-action="Index" class="vl-card p-4 d-block text-decoration-none text-reset h-100">
                <h5 class="mb-1">Listings</h5>
                <p class="text-muted small mb-0">Search all listings, suspend, remove, or restore them.</p>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-controller="AdminCategories" asp-action="Index" class="vl-card p-4 d-block text-decoration-none text-reset h-100">
                <h5 class="mb-1">Categories</h5>
                <p class="text-muted small mb-0">Manage the categories listings can be filed under.</p>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-controller="AdminReports" asp-action="Index" class="vl-card p-4 d-block text-decoration-none text-reset h-100">
                <h5 class="mb-1">Reports</h5>
                <p class="text-muted small mb-0">Review listings reported by users.</p>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-controller="AdminActivityLog" asp-action="Index" class="vl-card p-4 d-block text-decoration-none text-reset h-100">
                <h5 class="mb-1">Activity Log</h5>
                <p class="text-muted small mb-0">Audit trail of every moderation action taken.</p>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-controller="Admin" asp-action="Settings" class="vl-card p-4 d-block text-decoration-none text-reset h-100">
                <h5 class="mb-1">Site Settings</h5>
                <p class="text-muted small mb-0">Branding, homepage copy, footer, social links, maintenance mode.</p>
            </a>
        </div>
    </div>
</div>
