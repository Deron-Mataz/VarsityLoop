@model List<VarsityLoop.Models.Entities.ActivityLog>
@{
    ViewData["Title"] = "Activity Log";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Activity Log</h1>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Dashboard</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="vl-card vl-empty-state">
            <h5>No activity yet</h5>
            <p class="mb-0">Moderation actions (role changes, listing suspensions, report resolutions...) will show up here.</p>
        </div>
    }
    else
    {
        <div class="vl-card">
            <table class="table mb-0 align-middle">
                <thead>
                    <tr>
                        <th>When</th>
                        <th>Actor</th>
                        <th>Action</th>
                        <th>Target</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td class="small text-muted text-nowrap">@log.CreatedAt.ToDateTime().ToString("MMM d, yyyy HH:mm")</td>
                            <td>@log.ActorName</td>
                            <td>@log.Action</td>
                            <td class="small text-muted">@log.TargetType</td>
                            <td class="small">@log.Details</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
