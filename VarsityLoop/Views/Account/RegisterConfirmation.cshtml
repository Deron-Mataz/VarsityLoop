@{
    ViewData["Title"] = "Check Your Email";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="vl-card p-5">
                <h1 class="h3 mb-3">Check your inbox</h1>
                <p class="text-muted mb-4">
                    We've sent a verification link to your email address. Click it to activate your account, then log in below.
                </p>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Go to Log In</a>
            </div>
        </div>
    </div>
</div>
