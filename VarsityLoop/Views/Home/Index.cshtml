@{
    ViewData["Title"] = "Home";
    var heroImageUrl = ViewData["HeroImageUrl"] as string;
}

<section class="vl-hero py-5" style="@(!string.IsNullOrEmpty(heroImageUrl) ? $"background-image: linear-gradient(135deg, rgba(29,78,216,.82), rgba(232,80,63,.75)), url('{heroImageUrl}'); background-size: cover; background-position: center;" : "")">
    <div class="container py-5 text-center text-white vl-hero-content">
        <span class="badge badge-coral mb-3 px-3 py-2" style="font-size: 0.8rem;"><i class="bi bi-mortarboard-fill me-1"></i> Built for students, by students</span>
        <h1 class="fw-bold display-5">@(ViewData["HeroHeading"] ?? "Buy, sell, and swap with students at your university")</h1>
        <p class="lead mb-4 opacity-75">
            @(ViewData["HeroDescription"] ?? "Textbooks first, everything student life needs next.")
        </p>

        <form class="mx-auto vl-card p-2 d-flex" style="max-width: 640px;" asp-controller="Listings" asp-action="Browse" method="get">
            <input type="text" name="q" class="form-control border-0" placeholder="Search textbooks, courses, ISBNs..." />
            <button type="submit" class="btn btn-coral ms-2"><i class="bi bi-search"></i></button>
        </form>
    </div>
</section>

<div class="container py-5">

    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 mb-0"><i class="bi bi-fire text-danger me-2"></i>Featured Listings</h2>
            <a asp-controller="Listings" asp-action="Browse" class="small">View all &rarr;</a>
        </div>

        @{
            var featuredListings = ViewData["FeaturedListings"] as List<VarsityLoop.Models.Entities.Listing> ?? new();
        }
        @if (featuredListings.Count == 0)
        {
            <div class="vl-card vl-empty-state">
                <h5>No listings yet</h5>
                <p class="mb-0">Be the first to list a textbook once registrations open.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var listing in featuredListings)
                {
                    <div class="col-sm-6 col-md-3">
                        <partial name="_ListingCard" model="listing" />
                    </div>
                }
            </div>
        }
    </section>

    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 mb-0"><i class="bi bi-stars text-primary me-2"></i>Newest Listings</h2>
            <a asp-controller="Listings" asp-action="Browse" class="small">View all &rarr;</a>
        </div>

        @{
            var newestListings = ViewData["NewestListings"] as List<VarsityLoop.Models.Entities.Listing> ?? new();
        }
        @if (newestListings.Count == 0)
        {
            <div class="vl-card vl-empty-state">
                <h5>Nothing posted yet</h5>
                <p class="mb-0">New listings will show up here as soon as they're created.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var listing in newestListings)
                {
                    <div class="col-sm-6 col-md-3">
                        <partial name="_ListingCard" model="listing" />
                    </div>
                }
            </div>
        }
    </section>
</div>

<section class="vl-section-cream py-5">
    <div class="container">
        <h2 class="h4 mb-4">Browse Categories</h2>
        @{
            var categories = ViewData["Categories"] as List<VarsityLoop.Models.Entities.Category> ?? new();
            var categoryIcons = new[] { "bi-book", "bi-backpack2", "bi-laptop", "bi-house-door", "bi-lamp", "bi-mortarboard", "bi-pencil", "bi-flask" };
        }
        @if (categories.Count == 0)
        {
            <div class="vl-card vl-empty-state">
                <h5>Categories coming soon</h5>
                <p class="mb-0">Admins can add categories from the Admin Panel.</p>
            </div>
        }
        else
        {
            <div class="row g-3">
                @for (var i = 0; i < categories.Count; i++)
                {
                    <div class="col-6 col-md-3">
                        <a asp-controller="Listings" asp-action="Browse" asp-route-categoryId="@categories[i].Id"
                           class="vl-card vl-card-hover p-3 d-block text-center text-decoration-none text-reset h-100">
                            <div class="fs-3 mb-1 text-primary"><i class="bi @categoryIcons[i % categoryIcons.Length]"></i></div>
                            <span class="fw-semibold">@categories[i].Name</span>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</section>

<div class="container py-5">
    <section class="mb-5">
        <h2 class="h4 mb-4 text-center">How Varsity Loop Works</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="vl-card p-4 h-100">
                    <div class="vl-icon-tile blue"><i class="bi bi-pencil-square"></i></div>
                    <h5>1. Create a listing</h5>
                    <p class="text-muted mb-0">Post your textbook in minutes with photos and pricing.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="vl-card p-4 h-100">
                    <div class="vl-icon-tile"><i class="bi bi-people-fill"></i></div>
                    <h5>2. Connect with buyers</h5>
                    <p class="text-muted mb-0">Students at your university browse and reach out.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="vl-card p-4 h-100">
                    <div class="vl-icon-tile green"><i class="bi bi-check-circle-fill"></i></div>
                    <h5>3. Meet up and trade</h5>
                    <p class="text-muted mb-0">Arrange a safe, on-campus handoff.</p>
                </div>
            </div>
        </div>
    </section>
</div>

<section class="vl-section-peach py-5">
    <div class="container text-center">
        <h3 class="mb-3">Ready to save on textbooks?</h3>
        <p class="text-muted mb-4">Join students already buying and selling on Varsity Loop.</p>
        <a class="btn btn-coral btn-lg" asp-controller="Account" asp-action="Register">Get Started</a>
    </div>
</section>
