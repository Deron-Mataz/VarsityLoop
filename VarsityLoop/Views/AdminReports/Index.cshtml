@model List<VarsityLoop.Models.Entities.Report>
@{
    ViewData["Title"] = "Reports";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Reports</h1>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Dashboard</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (Model.Count == 0)
    {
        <div class="vl-card vl-empty-state">
            <h5>No reports</h5>
            <p class="mb-0">Reported listings will show up here for review.</p>
        </div>
    }
    else
    {
        <div class="vl-card">
            <table class="table mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Listing</th>
                        <th>Reported By</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var report in Model)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Listings" asp-action="Details" asp-route-id="@report.ListingId" class="text-reset text-decoration-none fw-semibold">@report.ListingTitle</a>
                            </td>
                            <td>@report.ReporterName</td>
                            <td class="small" style="max-width: 300px;">@report.Reason</td>
                            <td>
                                @{
                                    var badgeClass = report.Status switch
                                    {
                                        "Pending" => "bg-warning text-dark",
                                        "Resolved" => "badge-green",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @badgeClass">@report.Status</span>
                            </td>
                            <td class="small text-muted">@report.CreatedAt.ToDateTime().ToString("MMM d, yyyy")</td>
                            <td class="text-end">
                                @if (report.Status == "Pending")
                                {
                                    <div class="d-flex gap-2 justify-content-end">
                                        <form asp-controller="AdminReports" asp-action="Resolve" asp-route-id="@report.Id" method="post">
                                            <button type="submit" class="btn btn-sm btn-outline-primary">Resolve</button>
                                        </form>
                                        <form asp-controller="AdminReports" asp-action="Dismiss" asp-route-id="@report.Id" method="post">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Dismiss</button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
