@model VarsityLoop.Models.ViewModels.Accommodation.AccommodationFormViewModel
@{
    ViewData["Title"] = "List a Residence";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="h3 mb-4">List a Residence</h1>

            <form asp-controller="Accommodation" asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
                <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                <partial name="_AccommodationFormFields" model="Model" />
                <button type="submit" class="btn btn-primary">Publish Residence</button>
            </form>
        </div>
    </div>
</div>
