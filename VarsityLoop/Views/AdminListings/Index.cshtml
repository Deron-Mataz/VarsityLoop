@model List<VarsityLoop.Models.Entities.Listing>
@{
    ViewData["Title"] = "Listings";
    var searchTerm = ViewData["SearchTerm"] as string;
    var statusFilter = ViewData["StatusFilter"] as string;
    var statuses = new[] { "Active", "Paused", "Suspended", "Removed" };
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Listings</h1>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Dashboard</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <form asp-controller="AdminListings" asp-action="Index" method="get" class="vl-card p-3 d-flex gap-2 mb-4 flex-wrap">
        <input type="text" name="q" value="@searchTerm" class="form-control" style="max-width: 320px;" placeholder="Search title, seller, university..." />
        <select name="status" class="form-select" style="max-width: 200px;">
            <option value="">All Statuses</option>
            @foreach (var s in statuses)
            {
                <option value="@s" selected="@(statusFilter == s)">@s</option>
            }
        </select>
        <button type="submit" class="btn btn-primary">Filter</button>
    </form>

    @if (Model.Count == 0)
    {
        <div class="vl-card vl-empty-state">
            <h5>No listings match</h5>
            <p class="mb-0">Try a different search or status filter.</p>
        </div>
    }
    else
    {
        <div class="vl-card">
            <table class="table mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Listing</th>
                        <th>Seller</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var listing in Model)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Listings" asp-action="Details" asp-route-id="@listing.Id" class="text-reset text-decoration-none fw-semibold">@listing.Title</a>
                                <div class="text-muted small">@listing.University</div>
                            </td>
                            <td>@listing.SellerName</td>
                            <td>R@(listing.Price.ToString("N2"))</td>
                            <td>
                                @{
                                    var badgeClass = listing.Status switch
                                    {
                                        "Active" => "badge-green",
                                        "Paused" => "bg-secondary",
                                        "Suspended" => "bg-warning text-dark",
                                        _ => "bg-danger"
                                    };
                                }
                                <span class="badge @badgeClass">@listing.Status</span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-2 justify-content-end">
                                    @if (listing.Status is "Active" or "Paused")
                                    {
                                        <form asp-controller="AdminListings" asp-action="Suspend" asp-route-id="@listing.Id" method="post">
                                            <button type="submit" class="btn btn-sm btn-outline-warning">Suspend</button>
                                        </form>
                                        <form asp-controller="AdminListings" asp-action="Remove" asp-route-id="@listing.Id" method="post" onsubmit="return confirm('Remove this listing?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-controller="AdminListings" asp-action="Restore" asp-route-id="@listing.Id" method="post">
                                            <button type="submit" class="btn btn-sm btn-outline-primary">Restore</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
