{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Firebase": {
    "ProjectId": "your-firebase-project-id",
    "ApiKey": "your-firebase-web-api-key",
    "AuthDomain": "your-project.firebaseapp.com",
    "StorageBucket": "your-project.appspot.com",

    "_comment_ServiceAccountJson": "Yours",

    "_comment_ApiKey": "Yours",
    "_comment_AuthDomain": "Yours",
    "_comment_DatabaseUrl": "Yours",
    "_comment_StorageBucket": "Yours",
    "_comment_MessagingSenderId": "Yours",
    "_comment_AppId": "Yours",
    "_comment_MeasurementId": "Yours"

    "SessionCookieExpiryDays": 5,
    "RequireEmailVerification": true
  },

  "AppSettings": {
    "DefaultAdminEmail": "admin@example.com",
    "_comment": "Used only for first-run bootstrap logic to grant SuperAdmin role. Not a hardcoded credential."
  }
}
